import { getModel } from "../providers";

/**
 * AIモデルの設定
 *
 * getModel(プロバイダ名, モデル名, モデルID, オプション)
 * Vercel AI SDKを利用しているため各項目の内容もAI SDKに準拠
 *
 * なおこのファイルはGitの管理外にしているため、自由に変更可能
 */

// Example for Google Gemini
export const model = getModel("google", null, "gemma-4-31b-it", {
  maxOutputTokens: 65536,
  temperature: 1.0,
  topP: 0.95,
  topK: 64,
  providerOptions: {
    google: {
      generationConfig: {
        thinkingConfig: {
          thinkingLevel: "MINIMAL",
        },
      },
    },
  },
});

